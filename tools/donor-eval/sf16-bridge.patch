+// Rarog's diagnostic bridge (E.4.0.1): this tag's classical evaluation,
+// called from Rarog's search through a C ABI. Never shipped; see Rarog's
+// tools/donor-eval/README.md. Stockfish is GPL-3.0.
+
+#include <cstdint>
+#include <string>
+
+#include "bitboard.h"
+#include "endgame.h"
+#include "evaluate.h"
+#include "position.h"
+#include "thread.h"
+#include "uci.h"
+#include "psqt.h"
+#include "tune.h"
+
+namespace Stockfish {
+
+namespace {
+
+// Rarog's layout of a position; tools/donor-eval/bridge/src/main.rs mirrors it.
+struct RarogPosition {
+  uint8_t pieces[64]; // Stockfish piece codes by square, 0 empty
+  uint8_t side;       // 0 white, 1 black
+  uint8_t castling;   // WHITE_OO 1, WHITE_OOO 2, BLACK_OO 4, BLACK_OOO 8
+  uint8_t ep;         // the en-passant square, 64 for none
+  uint8_t rule50;
+  int32_t root;       // the root's last score in this evaluation's units
+};
+
+// One Stockfish thread object for each calling thread, made on its first
+// call and never freed: it holds the pawn and material tables the
+// evaluation probes, and the root score its lazy cut reads. Its own idle thread waits, unused.
+Thread* tables() {
+  static thread_local Thread* th = nullptr;
+  if (!th)
+  {
+      th = new Thread(0);
+  }
+  return th;
+}
+
+Value evaluate(const Position& pos) {
+  return Eval::classical_value(pos);
+}
+
+volatile uint64_t sink;
+
+} // namespace
+} // namespace Stockfish
+
+using namespace Stockfish;
+
+extern "C" {
+
+__declspec(dllexport) int32_t rarog_donor_init() {
+  UCI::init(Options);
+  Tune::init();
+  PSQT::init();
+  Bitboards::init();
+  Position::init();
+  Bitbases::init();
+  Endgames::init();
+  return 16;
+}
+
+// The evaluation from the side to move's point of view, in this tag's units.
+__declspec(dllexport) int32_t rarog_donor_eval(const RarogPosition* p) {
+  StateInfo st;
+  Position pos;
+  Thread* th = tables();
+  th->bestValue = Value(p->root);
+  pos.set_placement(p->pieces, Color(p->side), p->castling, p->ep < 64 ? int(p->ep) : -1,
+                    p->rule50, &st, th);
+  return evaluate(pos);
+}
+
+// The bridge's work without the evaluation, for its price.
+__declspec(dllexport) void rarog_donor_rebuild(const RarogPosition* p) {
+  StateInfo st;
+  Position pos;
+  pos.set_placement(p->pieces, Color(p->side), p->castling, p->ep < 64 ? int(p->ep) : -1,
+                    p->rule50, &st, tables());
+  sink = st.key;
+}
+
+// The same evaluation through the tag's own FEN setter, for parity.
+__declspec(dllexport) int32_t rarog_donor_eval_fen(const char* fen, int32_t root) {
+  StateInfo st;
+  Position pos;
+  Thread* th = tables();
+  th->bestValue = Value(root);
+  pos.set(std::string(fen), false, &st, th);
+  return evaluate(pos);
+}
+
+}
