+/// Position::set_placement() is Rarog's bridge (E.4.0.1): set() from a
+/// placement array instead of a FEN string, with the same steps in the
+/// same order, so both give the same position.
+
+Position& Position::set_placement(const uint8_t* placement, Color stm, int castling,
+                                  int ep, int rule50, StateInfo* si, Thread* th) {
+
+  std::memset(this, 0, sizeof(Position));
+  std::memset(si, 0, sizeof(StateInfo));
+  std::fill_n(&pieceList[0][0], sizeof(pieceList) / sizeof(Square), SQ_NONE);
+  st = si;
+
+  for (Square s = SQ_A1; s <= SQ_H8; ++s)
+      if (placement[s])
+          put_piece(Piece(placement[s]), s);
+
+  sideToMove = stm;
+
+  const int flags[4] = { WHITE_OO, WHITE_OOO, BLACK_OO, BLACK_OOO };
+  for (int f : flags)
+  {
+      if (!(castling & f))
+          continue;
+      Color c = (f == WHITE_OO || f == WHITE_OOO) ? WHITE : BLACK;
+      Piece rook = make_piece(c, ROOK);
+      Square rsq;
+      if (f == WHITE_OO || f == BLACK_OO)
+          for (rsq = relative_square(c, SQ_H1); piece_on(rsq) != rook; --rsq) {}
+      else
+          for (rsq = relative_square(c, SQ_A1); piece_on(rsq) != rook; ++rsq) {}
+      set_castling_right(c, rsq);
+  }
+
+  st->epSquare = SQ_NONE;
+  if (ep >= 0 && ep < 64 && (rank_of(Square(ep)) == RANK_3 || rank_of(Square(ep)) == RANK_6))
+  {
+      st->epSquare = Square(ep);
+      if (   !(attackers_to(st->epSquare) & pieces(sideToMove, PAWN))
+          || !(pieces(~sideToMove, PAWN) & (st->epSquare + pawn_push(~sideToMove))))
+          st->epSquare = SQ_NONE;
+  }
+
+  st->rule50 = rule50;
+  gamePly = 0;
+  chess960 = false;
+  thisThread = th;
+  set_state(st);
+
+  assert(pos_is_ok());
+
+  return *this;
+}
+
