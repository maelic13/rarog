 namespace Stockfish {
 
+// Rarog's HCE in place of the network, for Rarog's oracle reads: the search is
+// Stockfish's, unchanged; only the raw evaluation it consumes is Rarog's,
+// loaded from rarog_hce.dll beside the executable and scaled into the
+// network's units by the measured ratio (the `hcescale` command).
+namespace RarogHce {
+
+constexpr std::int64_t Scale1024 = 2660;
+
+using EvaluateFn = std::int32_t (*)(const std::uint64_t*, std::uint8_t, std::uint8_t, std::uint8_t);
+
+EvaluateFn load() {
+    wchar_t path[MAX_PATH];
+    const DWORD length = GetModuleFileNameW(nullptr, path, MAX_PATH);
+    if (!length || length == MAX_PATH)
+        std::abort();
+    wchar_t* separator = path + length;
+    while (separator != path && separator[-1] != L'\\' && separator[-1] != L'/')
+        --separator;
+    const wchar_t name[] = L"rarog_hce.dll";
+    if (separator - path + sizeof(name) / sizeof(name[0]) > MAX_PATH)
+        std::abort();
+    std::copy(name, name + sizeof(name) / sizeof(name[0]), separator);
+    HMODULE library = LoadLibraryW(path);
+    if (!library)
+    {
+        std::cerr << "rarog_hce.dll must sit beside the executable" << std::endl;
+        std::abort();
+    }
+    using AbiFn       = std::uint32_t (*)();
+    const FARPROC abi = GetProcAddress(library, "rarog_hce_abi_version");
+    const FARPROC fn  = GetProcAddress(library, "rarog_hce_evaluate");
+    if (!abi || !fn)
+        std::abort();
+    AbiFn      abiFn;
+    EvaluateFn evaluateFn;
+    std::memcpy(&abiFn, &abi, sizeof(abiFn));
+    std::memcpy(&evaluateFn, &fn, sizeof(evaluateFn));
+    if (abiFn() != 1)
+        std::abort();
+    return evaluateFn;
+}
+
+// Rarog's evaluation in centipawns, from the side to move.
+std::int32_t raw(const Position& pos) {
+    static const EvaluateFn evaluateFn = load();
+    std::uint64_t           pieces[12];
+    for (Color c : {WHITE, BLACK})
+        for (PieceType pt = PAWN; pt <= KING; ++pt)
+            pieces[c * 6 + pt - 1] = pos.pieces(c, pt);
+    const auto value = evaluateFn(
+      pieces, std::uint8_t(pos.side_to_move()),
+      std::uint8_t(pos.can_castle(WHITE_OO) * 1 | pos.can_castle(WHITE_OOO) * 2
+                   | pos.can_castle(BLACK_OO) * 4 | pos.can_castle(BLACK_OOO) * 8),
+      std::uint8_t(std::min(pos.rule50_count(), 100)));
+    if (value == std::numeric_limits<std::int32_t>::min())
+        std::abort();  // a corrupt position must never silently enter the search
+    return value;
+}
+
+// What the search reads where it read the network.
+Value evaluate(const Position& pos) {
+    const std::int64_t scaled = std::int64_t(raw(pos)) * Scale1024 / 1024;
+    return Value(std::clamp<std::int64_t>(scaled, VALUE_TB_LOSS_IN_MAX_PLY + 1,
+                                          VALUE_TB_WIN_IN_MAX_PLY - 1));
+}
+
