 // Trace scores are from white's point of view
+// Mean |raw network| and mean |Rarog HCE| over a file of FENs (one per line,
+// anything after ';' ignored), both from the side to move.
+void Eval::hce_scale(const std::string& path, const Eval::NNUE::Network& network) {
+    std::ifstream in(path);
+    if (!in)
+    {
+        sync_cout << "hcescale: cannot read " << path << sync_endl;
+        return;
+    }
+    auto        accumulators = std::make_unique<Eval::NNUE::AccumulatorStack>();
+    auto        caches       = std::make_unique<Eval::NNUE::AccumulatorCaches>(network);
+    double      net = 0, hce = 0;
+    std::size_t count = 0;
+    std::string line;
+    while (std::getline(in, line))
+    {
+        const auto fen = line.substr(0, line.find(';'));
+        if (fen.find_first_not_of(" \t\r") == std::string::npos)
+            continue;
+        StateInfo st;
+        Position  pos;
+        pos.set(fen, false, &st);
+        accumulators->reset();
+        net += std::abs(int(network.evaluate(pos, *accumulators, *caches)));
+        hce += std::abs(RarogHce::raw(pos));
+        ++count;
+    }
+    sync_cout << std::fixed << std::setprecision(2) << "hcescale positions " << count
+              << " mean_network " << net / count << " mean_hce " << hce / count
+              << " hce_over_network " << std::setprecision(4) << hce / net << " scale_1024 "
+              << std::setprecision(0) << 1024.0 * net / hce << sync_endl;
+}
