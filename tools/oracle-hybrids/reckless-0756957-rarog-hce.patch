+/// Mean |raw network| and mean |Rarog HCE| over a file of FENs (one per
+/// line, anything after `;` ignored), both from the side to move.
+fn hce_scale(td: &mut ThreadData, path: &str) {
+    let text = std::fs::read_to_string(path).expect("a readable FEN file");
+    let (mut count, mut network, mut hce) = (0u64, 0f64, 0f64);
+    for line in text.lines() {
+        let fen = line.split(';').next().unwrap_or("").trim();
+        if fen.is_empty() {
+            continue;
+        }
+        let board = Board::from_fen(fen).expect("a valid FEN");
+        td.nnue.full_refresh(&board);
+        network += f64::from(td.nnue.evaluate(&board).abs());
+        hce += f64::from(td.hce.raw(&board).abs());
+        count += 1;
+    }
+    let ratio = network / hce;
+    println!(
+        "hcescale positions {count} mean_network {:.2} mean_hce {:.2} hce_over_network {:.4} scale_1024 {:.0}",
+        network / count as f64,
+        hce / count as f64,
+        hce / network,
+        ratio * 1024.0
+    );
+}
