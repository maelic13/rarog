diff --git a/src/hce.rs b/src/hce.rs
new file mode 100644
index 0000000..d6a4267
--- /dev/null
+++ b/src/hce.rs
@@ -0,0 +1,75 @@
+//! Rarog's hand-crafted evaluation in place of the network, for Rarog's
+//! oracle reads: the search is Reckless's, unchanged; only the raw
+//! evaluation it consumes is Rarog's, scaled into the network's units.
+
+use std::hint::black_box;
+
+use rarog::board::{Bitboard as RarogBitboard, Board as RarogBoard, CastlingRights, Color as RarogColor};
+use rarog::eval::Evaluator;
+
+use crate::{
+    board::Board,
+    types::{Color, PieceType, Score},
+};
+
+/// Mean |raw network| over mean |Rarog HCE| on the scale corpus, in 1/1024
+/// (the `hcescale` command measures it).
+pub const SCALE_1024: i64 = 2536;
+
+const PIECE_TYPES: [PieceType; 6] =
+    [PieceType::Pawn, PieceType::Knight, PieceType::Bishop, PieceType::Rook, PieceType::Queen, PieceType::King];
+
+pub struct Hce {
+    evaluator: Evaluator,
+    /// Board builds per call, from `RAROG_HCE_BRIDGE_REPEAT` (default 1): the
+    /// bench's time per node at two counts prices the conversion.
+    repeat: u32,
+}
+
+impl Default for Hce {
+    fn default() -> Self {
+        let repeat = std::env::var("RAROG_HCE_BRIDGE_REPEAT")
+            .ok()
+            .and_then(|value| value.parse().ok())
+            .filter(|&repeat| repeat >= 1)
+            .unwrap_or(1);
+        Self { evaluator: Evaluator::default(), repeat }
+    }
+}
+
+fn placement(board: &Board) -> [RarogBitboard; 12] {
+    let mut pieces = [RarogBitboard(0); 12];
+    for (color_index, color) in [Color::White, Color::Black].into_iter().enumerate() {
+        for (piece_index, piece) in PIECE_TYPES.into_iter().enumerate() {
+            pieces[color_index * 6 + piece_index] = RarogBitboard((board.pieces(piece) & board.colors(color)).0);
+        }
+    }
+    pieces
+}
+
+fn rarog_board(pieces: [RarogBitboard; 12], board: &Board) -> RarogBoard {
+    let side = if board.side_to_move() == Color::White { RarogColor::White } else { RarogColor::Black };
+    let clock = board.fiftymove_clock();
+    // Chess960 rights the placement cannot hold are dropped, as the DLL does.
+    RarogBoard::from_placement(pieces, side, CastlingRights(board.castling().raw()), clock)
+        .or_else(|_| RarogBoard::from_placement(pieces, side, CastlingRights(0), clock))
+        .expect("Reckless hands over a legal position")
+}
+
+impl Hce {
+    /// Rarog's evaluation in centipawns, from the side to move.
+    pub fn raw(&mut self, board: &Board) -> i32 {
+        let pieces = placement(board);
+        for _ in 1..self.repeat {
+            black_box(rarog_board(black_box(pieces), board));
+        }
+        self.evaluator.evaluate(&rarog_board(pieces, board))
+    }
+
+    /// What the search reads where it read the network.
+    pub fn evaluate(&mut self, board: &Board) -> i32 {
+        let scaled = i64::from(self.raw(board)) * SCALE_1024 / 1024;
+        let bound = i64::from(Score::TB_WIN_IN_MAX - 1);
+        scaled.clamp(-bound, bound) as i32
+    }
+}
