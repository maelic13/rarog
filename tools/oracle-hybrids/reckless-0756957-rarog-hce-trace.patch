diff --git a/src/trace.rs b/src/trace.rs
new file mode 100644
index 0000000..28543c3
--- /dev/null
+++ b/src/trace.rs
@@ -0,0 +1,167 @@
+// RAR-O D.7.3: the parity instrument's twin. Diagnostic only; nothing here
+// changes a search decision, a node count or a table entry.
+//
+//   RAROG_TRACE=<file>        decision records of sampled nodes, one line each:
+//                             `<kind> <name>=<int> ...`
+//   RAROG_TRACE_STRIDE=<n>    every n-th node entry is sampled (default 64);
+//                             the picker, the wrapper and the history gravity,
+//                             which run outside a node's own frame, sample
+//                             every n-th call of their own.
+//   RAROG_SPREAD_SALT=<k>     added to the node count inside the two LMR
+//                             spread terms and the draw score (the noise floor).
+//   RAROG_PLANT=<name>        a planted difference: `unreduced` (the full-depth
+//                             search's reductions removed), `lmr_check` (no LMR
+//                             at a node in check), `q5` (quiescence stops at the
+//                             fifth move, not the third).
+//
+// Every rule's attempts and firings are counted at every node and printed as
+// `info string rates <kind>=<fires>/<attempts> ...` before `bestmove`.
+
+use std::cell::{Cell, RefCell};
+use std::collections::BTreeMap;
+use std::fs::OpenOptions;
+use std::io::{BufWriter, Write};
+use std::sync::OnceLock;
+
+struct Config {
+    path: Option<String>,
+    stride: u64,
+    salt: u64,
+    plant: String,
+}
+
+fn config() -> &'static Config {
+    static CONFIG: OnceLock<Config> = OnceLock::new();
+    CONFIG.get_or_init(|| Config {
+        path: std::env::var("RAROG_TRACE").ok().filter(|p| !p.is_empty()),
+        stride: std::env::var("RAROG_TRACE_STRIDE").ok().and_then(|s| s.parse().ok()).unwrap_or(64).max(1),
+        salt: std::env::var("RAROG_SPREAD_SALT").ok().and_then(|s| s.parse().ok()).unwrap_or(0),
+        plant: std::env::var("RAROG_PLANT").unwrap_or_default(),
+    })
+}
+
+thread_local! {
+    static WRITER: RefCell<Option<BufWriter<std::fs::File>>> = const { RefCell::new(None) };
+    static RATES: RefCell<BTreeMap<&'static str, (u64, u64)>> = const { RefCell::new(BTreeMap::new()) };
+    static ENTRIES: Cell<u64> = const { Cell::new(0) };
+    static CALLS: RefCell<BTreeMap<&'static str, u64>> = const { RefCell::new(BTreeMap::new()) };
+}
+
+/// Whether records are written at all (the root's own decisions are all written).
+pub fn enabled() -> bool {
+    config().path.is_some()
+}
+
+/// The salt added to the node count in the spread terms and the draw score.
+pub fn salt() -> u64 {
+    config().salt
+}
+
+/// Whether the named plant is active.
+pub fn plant(name: &str) -> bool {
+    config().plant == name
+}
+
+/// A node entry: whether this node's decisions are written.
+pub fn enter_node() -> bool {
+    let n = ENTRIES.with(|e| {
+        let n = e.get();
+        e.set(n + 1);
+        n
+    });
+    config().path.is_some() && n % config().stride == 0
+}
+
+/// A call outside a node's frame: whether this call is written.
+pub fn sample_call(kind: &'static str) -> bool {
+    if config().path.is_none() {
+        return false;
+    }
+    CALLS.with(|c| {
+        let mut c = c.borrow_mut();
+        let n = c.entry(kind).or_insert(0);
+        *n += 1;
+        (*n - 1) % config().stride == 0
+    })
+}
+
+/// One decision: counted always, written when `on`.
+pub fn rule(on: bool, kind: &'static str, fire: bool, fields: &[(&'static str, i64)]) {
+    RATES.with(|r| {
+        let mut r = r.borrow_mut();
+        let e = r.entry(kind).or_insert((0, 0));
+        e.0 += fire as u64;
+        e.1 += 1;
+    });
+    if !on {
+        return;
+    }
+    let Some(path) = &config().path else { return };
+    WRITER.with(|w| {
+        let mut w = w.borrow_mut();
+        if w.is_none() {
+            let file = OpenOptions::new().create(true).append(true).open(path).expect("RAROG_TRACE file");
+            *w = Some(BufWriter::new(file));
+        }
+        let out = w.as_mut().unwrap();
+        let _ = write!(out, "{kind} fire={}", fire as i64);
+        for (name, value) in fields {
+            let _ = write!(out, " {name}={value}");
+        }
+        let _ = writeln!(out);
+    });
+}
+
+/// A record written when `on` and never counted in the rates: the kinds added
+/// in D.7.4, so the rates line stays the one layer B was calibrated on.
+pub fn note(on: bool, kind: &'static str, fire: bool, fields: &[(&'static str, i64)]) {
+    if !on {
+        return;
+    }
+    let Some(path) = &config().path else { return };
+    WRITER.with(|w| {
+        let mut w = w.borrow_mut();
+        if w.is_none() {
+            let file = OpenOptions::new().create(true).append(true).open(path).expect("RAROG_TRACE file");
+            *w = Some(BufWriter::new(file));
+        }
+        let out = w.as_mut().unwrap();
+        let _ = write!(out, "{kind} fire={}", fire as i64);
+        for (name, value) in fields {
+            let _ = write!(out, " {name}={value}");
+        }
+        let _ = writeln!(out);
+    });
+}
+
+/// The rates of the search just finished, then cleared; the trace flushed.
+pub fn finish_search() {
+    let line = RATES.with(|r| {
+        let mut r = r.borrow_mut();
+        let body: Vec<String> = r.iter().map(|(k, (f, a))| format!("{k}={f}/{a}")).collect();
+        r.clear();
+        body.join(" ")
+    });
+    println!("info string rates {line}");
+    WRITER.with(|w| {
+        if let Some(out) = w.borrow_mut().as_mut() {
+            let _ = out.flush();
+        }
+    });
+}
+
+/// `rule` with named fields.
+#[macro_export]
+macro_rules! tr {
+    ($on:expr, $kind:literal, $fire:expr $(, $name:ident = $val:expr)* $(,)?) => {
+        crate::trace::rule($on, $kind, $fire, &[$((stringify!($name), ($val) as i64)),*])
+    };
+}
+
+/// `note` with named fields.
+#[macro_export]
+macro_rules! trn {
+    ($on:expr, $kind:literal, $fire:expr $(, $name:ident = $val:expr)* $(,)?) => {
+        crate::trace::note($on, $kind, $fire, &[$((stringify!($name), ($val) as i64)),*])
+    };
+}
