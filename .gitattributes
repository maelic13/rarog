# Auto detect text files and perform LF normalization
* text=auto

# Preserve archived measurement bytes exactly; patches and raw logs may contain
# whitespace that is meaningful to their recorded SHA-256 identities.
analysis/artifacts/see-normalized-20260907/** -text -whitespace

# Stored arm recipes must stay byte-exact: a CRLF round-trip breaks `git apply`.
analysis/arm_patches/*.patch -text -whitespace

# Oracle hybrid recipes apply to donor trees with their own endings.
tools/oracle-hybrids/*.patch -text -whitespace

# The donor-eval bridge's patches apply to the Stockfish tags' own LF bytes,
# and its build script runs in Bash, which a CR breaks.
tools/donor-eval/*.patch -text -whitespace
tools/donor-eval/*.sh text eol=lf

# Donor snapshot manifests: `sha256sum -c` reads them only with LF endings.
analysis/triumviratus_snapshot/*.sha256 -text

# Committed Syzygy tables are binary test fixtures; never convert them.
tests/fixtures/syzygy/*.rtbw -text -diff
tests/fixtures/syzygy/*.rtbz -text -diff
# The game-position NPS sets: their manifests hash these exact bytes.
tools/nps_positions_v*.jsonl -text
