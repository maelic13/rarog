+/// D.5 item 15 probe: a static eval whose raw value is a hard draw verdict,
+/// counted by family, and whether the correction moved it off 0.
+#[cfg(feature = "diag")]
+fn probe_verdict(board: &Board, raw: i32, eval: i32) {
+    use crate::diag::counters as c;
+    use std::sync::atomic::Ordering::Relaxed;
+    if raw != 0 {
+        return;
+    }
+    let Some(kind) = crate::eval::endgame::draw_verdict_kind(board) else {
+        return;
+    };
+    let (leaf, moved) = match kind {
+        0 => (&c::verdict_leaf_kpk, &c::verdict_moved_kpk),
+        1 => (&c::verdict_leaf_kbp, &c::verdict_moved_kbp),
+        2 => (&c::verdict_leaf_minor, &c::verdict_moved_minor),
+        3 => (&c::verdict_leaf_knnk, &c::verdict_moved_knnk),
+        _ => (&c::verdict_leaf_other, &c::verdict_moved_other),
+    };
+    leaf.fetch_add(1, Relaxed);
+    if eval != 0 {
+        moved.fetch_add(1, Relaxed);
+        c::verdict_moved_abs_sum.fetch_add(u64::from(eval.unsigned_abs()), Relaxed);
+        if eval.abs() >= 50 {
+            c::verdict_moved_ge50.fetch_add(1, Relaxed);
+        }
+    }
+}
