+/// The hard draw verdict `scale_endgame` returns for `board`, by family: 0 the
+/// drawn KPK, 1 the wrong-corner KBP, 2 a pawnless minor-material draw, 3 KNNK,
+/// 4 any other recogniser's zero scale; `None` when the value is no verdict.
+#[cfg(feature = "diag")]
+pub(crate) fn draw_verdict_kind(board: &Board) -> Option<usize> {
+    let bare_king = has_only_king(board, Color::White) || has_only_king(board, Color::Black);
+    if board.occupied_count() > 5 && !bare_king {
+        return None;
+    }
+    if knnkp_adjustment(board).is_some() {
+        return None;
+    }
+    if let Some((white_to_move, wk, bk, p)) = kpk_normalized(board) {
+        return (!kpk::probe(white_to_move, wk, bk, p)).then_some(0);
+    }
+    if kbp_wrong_corner_draw(board) {
+        return Some(1);
+    }
+    match specialized_endgame_scale(board) {
+        Some(0) => {
+            let pawnless = board.pieces(Color::White, Piece::Pawn).is_empty()
+                && board.pieces(Color::Black, Piece::Pawn).is_empty();
+            return Some(if pawnless { 2 } else { 4 });
+        }
+        Some(_) => return None,
+        None => {}
+    }
+    let knnk = (has_only_king(board, Color::White) && has_only_knights(board, Color::Black, 2))
+        || (has_only_king(board, Color::Black) && has_only_knights(board, Color::White, 2));
+    knnk.then_some(3)
+}
