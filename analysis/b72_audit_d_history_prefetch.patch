+    /// Ask for the history rows the quiets' scoring reads, before the quiets
+    /// are generated, so the rows arrive while generation runs.
+    #[inline(always)]
+    fn prefetch_quiet_histories(&self, board: &Board, ply: usize) {
+        let mut cont = [None; 4];
+        for (slot, back) in CONT_PLY_BACK.into_iter().take(4).enumerate() {
+            cont[slot] = self.cont_context_back(ply, back);
+        }
+        self.td.hist.prefetch_quiet_rows(
+            HistoryTables::pawn_row(board.pawn_key()),
+            &cont,
+            board.side_to_move(),
+        );
+    }
