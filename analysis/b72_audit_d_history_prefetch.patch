+    /// Prefetch the rows quiet scoring reads for `stm` at this node: its half
+    /// of the pawn-history row and of each continuation row. A half row is
+    /// 384 entries, 768 bytes; thirteen lines cover it at any alignment.
+    #[inline(always)]
+    pub(super) fn prefetch_quiet_rows(&self, pawn_row: usize, contexts: &[Option<usize>], stm: Color) {
+        let half = stm as usize * 6 * 64;
+        let fetch = |table: &[i16], base: usize| {
+            let start = table.as_ptr().wrapping_add(base + half).cast::<u8>();
+            for line in 0..13 {
+                crate::tt::prefetch_ptr(start.wrapping_add(line * 64));
+            }
+        };
+        fetch(&self.pawn[..], pawn_row);
+        for context in contexts.iter().flatten() {
+            fetch(&self.cont[..], *context);
+        }
+    }
