diff --git a/src/search/s120.rs b/src/search/s120.rs
new file mode 100644
index 0000000..ceadd1f
--- /dev/null
+++ b/src/search/s120.rs
@@ -0,0 +1,86 @@
+//! RAR-S120's instrument: the cycles spent generating and scoring a node's
+//! captures before its TT move, the part spent at nodes that cut before using
+//! them, and how often scores taken after the TT move's search would reorder
+//! them. Main thread, one thread; dumped once per search.
+
+use std::cell::Cell;
+use std::sync::OnceLock;
+use std::thread::LocalKey;
+
+thread_local! {
+    static START: Cell<u64> = const { Cell::new(0) };
+    static FILL: Cell<u64> = const { Cell::new(0) };
+    static FILL_N: Cell<u64> = const { Cell::new(0) };
+    static UNUSED: Cell<u64> = const { Cell::new(0) };
+    static UNUSED_N: Cell<u64> = const { Cell::new(0) };
+    static ORDER_N: Cell<u64> = const { Cell::new(0) };
+    static ORDER_MULTI: Cell<u64> = const { Cell::new(0) };
+    static ORDER_TOP: Cell<u64> = const { Cell::new(0) };
+    static ORDER_ANY: Cell<u64> = const { Cell::new(0) };
+}
+
+#[inline(always)]
+pub(super) fn tsc() -> u64 {
+    #[allow(unused_unsafe, reason = "`_rdtsc` is unsafe on older toolchains")]
+    // SAFETY: reading the time-stamp counter has no preconditions on x86-64.
+    unsafe {
+        core::arch::x86_64::_rdtsc()
+    }
+}
+
+fn bump(cell: &'static LocalKey<Cell<u64>>, by: u64) {
+    cell.with(|c| c.set(c.get() + by));
+}
+
+pub(super) fn search_begin() {
+    for cell in [&FILL, &FILL_N, &UNUSED, &UNUSED_N, &ORDER_N, &ORDER_MULTI, &ORDER_TOP, &ORDER_ANY] {
+        cell.with(|c| c.set(0));
+    }
+    START.with(|c| c.set(tsc()));
+}
+
+pub(super) fn add_fill(cycles: u64) {
+    bump(&FILL, cycles);
+    bump(&FILL_N, 1);
+}
+
+pub(super) fn add_unused(cycles: u64) {
+    bump(&UNUSED, cycles);
+    bump(&UNUSED_N, 1);
+}
+
+/// Whether the reorder count runs, from `RAROG_S120_ORDER=1`; it adds work.
+pub(super) fn order_on() -> bool {
+    static ON: OnceLock<bool> = OnceLock::new();
+    *ON.get_or_init(|| std::env::var("RAROG_S120_ORDER").is_ok_and(|v| v.trim() == "1"))
+}
+
+pub(super) fn add_order(multi: bool, top_differs: bool, any_differs: bool) {
+    bump(&ORDER_N, 1);
+    bump(&ORDER_MULTI, u64::from(multi));
+    bump(&ORDER_TOP, u64::from(top_differs));
+    bump(&ORDER_ANY, u64::from(any_differs));
+}
+
+pub(super) fn dump() {
+    let total = tsc().wrapping_sub(START.with(Cell::get));
+    let mut pair = u64::MAX;
+    for _ in 0..256 {
+        let a = tsc();
+        let b = tsc();
+        pair = pair.min(b.wrapping_sub(a));
+    }
+    let g = |cell: &'static LocalKey<Cell<u64>>| cell.with(Cell::get);
+    println!(
+        "info string s120 search {total} fill {} fill_n {} unused {} unused_n {} pair {pair} \
+         order_n {} order_multi {} order_top {} order_any {}",
+        g(&FILL),
+        g(&FILL_N),
+        g(&UNUSED),
+        g(&UNUSED_N),
+        g(&ORDER_N),
+        g(&ORDER_MULTI),
+        g(&ORDER_TOP),
+        g(&ORDER_ANY),
+    );
+}
