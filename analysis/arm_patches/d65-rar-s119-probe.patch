+thread_local! {
+    /// RAR-S119: while set, every exclusion node takes the plain corrected
+    /// eval as its estimate. Set only inside a RAR-S119 probe.
+    pub(super) static S119_PLAIN: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+    /// The node count a running RAR-S119 probe started at; none outside one.
+    pub(super) static S119_START: std::cell::Cell<Option<u64>> = const { std::cell::Cell::new(None) };
+    /// The running RAR-S119 probe reached its node cap and was stopped.
+    pub(super) static S119_CAPPED: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// A RAR-S119 probe stops at this many nodes, its record then void: 2,000,000,
+/// or `RAROG_S119_CAP` for the plant test.
+pub(super) fn s119_cap() -> u64 {
+    static CAP: OnceLock<u64> = OnceLock::new();
+    *CAP.get_or_init(|| {
+        std::env::var("RAROG_S119_CAP")
+            .ok()
+            .and_then(|raw| raw.trim().parse().ok())
+            .unwrap_or(2_000_000)
+    })
+}
+
+/// RAR-S119's sample shift from `RAROG_S119_SHIFT`; unset is off.
+fn s119_shift() -> Option<u32> {
+    static SHIFT: OnceLock<Option<u32>> = OnceLock::new();
+    *SHIFT.get_or_init(|| {
+        std::env::var("RAROG_S119_SHIFT")
+            .ok()
+            .and_then(|raw| raw.trim().parse::<u32>().ok())
+            .filter(|shift| *shift < 32)
+    })
+}
+
+/// Append one RAR-S119 record to `RAROG_S119_OUT`.
+pub(super) fn s119_write(line: &str) {
+    static PATH: OnceLock<Option<String>> = OnceLock::new();
+    if let Some(path) = PATH.get_or_init(|| std::env::var("RAROG_S119_OUT").ok()) {
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .open(path)
+            .expect("RAROG_S119_OUT opens");
+        writeln!(file, "{line}").expect("RAR-S119 record writes");
+    }
+}
+
+impl Searcher {
+    /// Whether this singular attempt is in RAR-S119's sample: drawn from
+    /// the position and depth, main thread, one thread, never in a probe.
+    pub(super) fn s119_sampled(&self, key: u64, depth: i32) -> bool {
+        let Some(shift) = s119_shift() else {
+            return false;
+        };
+        if self.td.pricing.probing || self.shared.threads != 1 || self.td.thread_id != 0 {
+            return false;
+        }
+        let depth_bits = u64::from(depth.clamp(0, 255).cast_unsigned());
+        mix(key ^ 0x5119_5119 ^ (depth_bits << 40)) & ((1u64 << shift) - 1) == 0
+    }
+
+    /// One exclusion search below `singular_beta` at `depth`, isolated as a
+    /// pricing probe on an empty scratch table, with `plain` choosing the
+    /// estimate at every exclusion node it reaches. Its score and nodes.
+    #[allow(clippy::too_many_arguments, reason = "a screen instrument")]
+    pub(super) fn s119_exclusion_probe<P: FnMut() -> SearchEvent + ?Sized>(
+        &mut self,
+        board: &mut Board,
+        depth: i32,
+        singular_beta: i32,
+        ply: usize,
+        excluded: Move,
+        cut_node: bool,
+        plain: bool,
+        poll: &mut P,
+    ) -> (i32, u64, bool) {
+        self.td.pricing.scratch = None;
+        let was_stopped = self.td.stopped;
+        let saved = self.probe_begin();
+        S119_PLAIN.with(|cell| cell.set(plain));
+        S119_CAPPED.with(|cell| cell.set(false));
+        S119_START.with(|cell| cell.set(Some(self.td.nodes)));
+        let score = self.negamax::<NonPv, _>(
+            board,
+            depth,
+            singular_beta - 1,
+            singular_beta,
+            ply,
+            false,
+            excluded,
+            cut_node,
+            ply,
+            poll,
+        );
+        S119_PLAIN.with(|cell| cell.set(false));
+        S119_START.with(|cell| cell.set(None));
+        let capped = S119_CAPPED.with(std::cell::Cell::get);
+        let nodes = self.probe_end(&saved);
+        // A cap stops only the probe; the measured search goes on as it was.
+        self.td.stopped = was_stopped;
+        (score, nodes, capped)
+    }
+}
