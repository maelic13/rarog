+#[cfg(test)]
+mod d61_screen {
+    use super::is_noisy;
+    use crate::board::Board;
+
+    #[test]
+    fn quiet_and_noisy_agree_over_legal_moves() {
+        let extra = [
+            "r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1",
+            "r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1",
+            "1n6/P6k/8/8/8/8/8/K7 w - - 0 1",
+            "4k3/8/8/3pP3/8/8/8/4K3 w - d6 0 1",
+        ];
+        let (mut total, mut disagreeing, mut castling) = (0, 0, 0);
+        for fen in crate::bench::BENCH_FENS.iter().chain(extra.iter()) {
+            let board = Board::from_fen(fen).expect("valid FEN");
+            for mv in board.generate_legal_moves() {
+                total += 1;
+                if board.is_quiet_move(mv) == is_noisy(mv) {
+                    disagreeing += 1;
+                    castling += usize::from(mv.is_castling());
+                    println!("disagree {mv} flags {} in {fen}", mv.flags());
+                }
+            }
+        }
+        println!("legal moves {total}, disagreeing {disagreeing}, of them castling {castling}");
+        assert_eq!(disagreeing, 0);
+    }
+}
