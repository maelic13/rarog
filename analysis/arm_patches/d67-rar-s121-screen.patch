+    /// RAR-S121: a node at the ply cap. Its line's plies plus the depth it
+    /// still had split into the iteration's depth, the budgeted positive
+    /// extensions, the quiescence plies, and the rest: depth the line
+    /// gained outside the budget, net of its reductions.
+    #[cfg(feature = "diag")]
+    fn s121_cap(&self, board: &Board, ply: usize, qply: usize, depth: i32) {
+        crate::diag_count!(cap_n);
+        if qply > 0 {
+            crate::diag_count!(cap_q);
+        }
+        if qply >= MAX_QPLY {
+            crate::diag_count!(cap_q_deep);
+        }
+        if board.is_in_check() {
+            crate::diag_count!(cap_check);
+        }
+        if board.can_declare_draw_in_search() {
+            crate::diag_count!(cap_draw);
+        }
+        let frontier = ply - qply;
+        let ext = self.td.stack[frontier - 1].extension_spent.max(0);
+        let root = self.td.root_depth.max(0);
+        let left = depth.max(0);
+        let q = infra::to_i32(qply);
+        let unb = infra::to_i32(ply) + left - root - ext - q;
+        let as_u64 = |v: i32| u64::try_from(v.max(0)).unwrap_or(0);
+        crate::diag_add!(cap_sum_root, as_u64(root));
+        crate::diag_add!(cap_sum_ext, as_u64(ext));
+        crate::diag_add!(cap_sum_q, as_u64(q));
+        crate::diag_add!(cap_sum_unb, as_u64(unb));
+        crate::diag_add!(cap_sum_depth, as_u64(left));
+        if unb < 0 {
+            crate::diag_count!(cap_unb_negative);
+        }
+    }
