+/// RAR-S109's arm mask: 1 types the null child `false`, 2 both ProbCut
+/// searches, 4 makes an `Upper` store pass no move. Read once per process.
+fn s109_arm() -> u32 {
+    static ARM: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *ARM.get_or_init(|| {
+        std::env::var("RAROG_S109_ARM")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
+
+#[cfg(feature = "diag")]
+static S109_NULL_DEPTH: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+#[cfg(feature = "diag")]
+static S109_PC_DEPTH: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+#[cfg(feature = "diag")]
+fn s109_interior() -> u64 {
+    crate::diag::counters::nodes.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+#[cfg(feature = "diag")]
+fn s109_zw(cut: bool, fail_high: bool) {
+    if cut {
+        crate::diag_count!(ch_zw_cut_n);
+        if fail_high {
+            crate::diag_count!(ch_zw_cut_fh);
+        }
+    } else {
+        crate::diag_count!(ch_zw_all_n);
+        if fail_high {
+            crate::diag_count!(ch_zw_all_fh);
+        }
+    }
+}
+
+/// Enter a counted child subtree; true when it is the outermost of its class.
+#[cfg(feature = "diag")]
+fn s109_enter(depth: &std::sync::atomic::AtomicU32) -> (bool, u64) {
+    let outer = depth.fetch_add(1, std::sync::atomic::Ordering::Relaxed) == 0;
+    (outer, s109_interior())
+}
+
+#[cfg(feature = "diag")]
+fn s109_leave(depth: &std::sync::atomic::AtomicU32, entry: (bool, u64), pc: bool) {
+    depth.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+    if entry.0 {
+        let inside = s109_interior() - entry.1;
+        if pc {
+            crate::diag_add!(ch_pc_nodes, inside);
+        } else {
+            crate::diag_add!(ch_null_nodes, inside);
+        }
+    }
+}
