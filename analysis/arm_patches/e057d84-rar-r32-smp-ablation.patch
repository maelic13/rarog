+/// Instrument only, never merged: `RAROG_ABLATE` names the parallel-search
+/// members to switch off, read once per process. Each member's first
+/// consultation is written to stderr once, so a wire check sees every site
+/// reached and which way it went.
+pub(crate) mod ablate {
+    use std::sync::OnceLock;
+    use std::sync::atomic::{AtomicU8, Ordering};
+
+    pub(crate) const ORDER: u8 = 1;
+    pub(crate) const CENTER: u8 = 2;
+    pub(crate) const ROTATE: u8 = 4;
+    pub(crate) const JITTER: u8 = 8;
+
+    static MASK: OnceLock<u8> = OnceLock::new();
+    static SEEN: AtomicU8 = AtomicU8::new(0);
+
+    pub(crate) fn off(member: u8) -> bool {
+        let off = mask() & member != 0;
+        if SEEN.load(Ordering::Relaxed) & member == 0
+            && SEEN.fetch_or(member, Ordering::Relaxed) & member == 0
+        {
+            eprintln!("ablate: member {member} consulted, off {off}");
+        }
+        off
+    }
+
+    fn mask() -> u8 {
+        *MASK.get_or_init(|| {
+            let value = std::env::var("RAROG_ABLATE").unwrap_or_default();
+            [
+                ("order", ORDER),
+                ("center", CENTER),
+                ("rotate", ROTATE),
+                ("jitter", JITTER),
+            ]
+            .iter()
+            .filter(|(name, _)| value.contains(name))
+            .fold(0, |mask, (_, bit)| mask | bit)
+        })
+    }
+}
