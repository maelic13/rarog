+    fn see_ge_variant(&self, mv: Move, threshold: i32, values: SeeValues, variant: u32) -> bool {
+        if variant & 8 != 0 && mv.is_castling() {
+            return true;
+        }
+        let mut gain = self
+            .captured_piece(mv)
+            .map_or(0, |piece| values.value(piece));
+        let mut occupant = self.moving_piece(mv);
+        if mv.is_promo() {
+            occupant = mv.promo_piece();
+            gain += values.value(occupant) - values.value(Piece::Pawn);
+        }
+        if gain < threshold {
+            return false;
+        }
+        let target = mv.to_sq();
+        let mut occ = self.see_occupancy(mv);
+        let mut side = self.side_to_move;
+        let mut result = true;
+        let mut limit = gain - threshold + 1;
+        let pins = [self.static_pins(Color::White), self.static_pins(Color::Black)];
+        while occupant != Piece::King {
+            side = !side;
+            let recapture = if variant & 2 != 0 {
+                let mut ours = self.attackers_to_color(target, occ, side) & occ;
+                let (pinned, _) = pins[side as usize];
+                let (_, their_pinners) = pins[!side as usize];
