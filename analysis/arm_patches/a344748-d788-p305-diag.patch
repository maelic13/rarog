+        let snipers = (atk.rook(king, Bitboard::EMPTY)
+            & (self.pieces(them, Piece::Rook) | self.pieces(them, Piece::Queen)))
+            | (atk.bishop(king, Bitboard::EMPTY)
+                & (self.pieces(them, Piece::Bishop) | self.pieces(them, Piece::Queen)));
+        let mut pinned = Bitboard::EMPTY;
+        let mut pinners = Bitboard::EMPTY;
+        for sniper in snipers {
+            let blockers = between(king, sniper) & self.all_occ;
+            if blockers.count() == 1 && (blockers & self.color_occ(color)).any() {
