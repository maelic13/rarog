+/// D.6.2's screen: the legal quiet queen promotions here, and for each whether
+/// the opponent attacks its square once the pawn has left.
+#[cfg(feature = "diag")]
+fn diag_quiet_queen_promotions(board: &mut Board) -> (usize, Vec<bool>) {
+    let promos: Vec<Move> = board
+        .generate_legal_quiets()
+        .iter()
+        .copied()
+        .filter(|mv| mv.is_promo() && mv.promo_piece() == Piece::Queen)
+        .collect();
+    let mut safe = Vec::with_capacity(promos.len());
+    for mv in &promos {
+        let them = !board.side_to_move();
+        board.make_move(*mv);
+        safe.push(!board.is_attacked(mv.to_sq(), them));
+        board.unmake_move(*mv);
+    }
+    (promos.len(), safe)
+}
