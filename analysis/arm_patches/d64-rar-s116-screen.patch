+
+/// RAR-S109's arm mask: 1 types the null child `false`, 2 both ProbCut
+/// searches, 4 makes an `Upper` store pass no move. RAR-S116 adds 16, 32
+/// and 64, which make IIR, the cut-node LMR term and the razoring guard read
+/// a main-search fail-low entry as carrying a move whatever it holds, and
+/// 128, which takes such an entry's move from the picker and leaves the
+/// consumers theirs. Read once per process.
+fn s109_arm() -> u32 {
+    static ARM: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *ARM.get_or_init(|| {
+        std::env::var("RAROG_S109_ARM")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
+
+#[cfg(feature = "diag")]
+static S109_NULL_DEPTH: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+#[cfg(feature = "diag")]
+static S109_PC_DEPTH: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+#[cfg(feature = "diag")]
+fn s109_interior() -> u64 {
+    crate::diag::counters::nodes.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+#[cfg(feature = "diag")]
+fn s109_zw(cut: bool, fail_high: bool) {
+    if cut {
+        crate::diag_count!(ch_zw_cut_n);
+        if fail_high {
+            crate::diag_count!(ch_zw_cut_fh);
+        }
+    } else {
+        crate::diag_count!(ch_zw_all_n);
+        if fail_high {
+            crate::diag_count!(ch_zw_all_fh);
+        }
+    }
+}
+
+/// Enter a counted child subtree; true when it is the outermost of its class.
+#[cfg(feature = "diag")]
+fn s109_enter(depth: &std::sync::atomic::AtomicU32) -> (bool, u64) {
+    let outer = depth.fetch_add(1, std::sync::atomic::Ordering::Relaxed) == 0;
+    (outer, s109_interior())
+}
+
+#[cfg(feature = "diag")]
+fn s109_leave(depth: &std::sync::atomic::AtomicU32, entry: (bool, u64), pc: bool) {
+    depth.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+    if entry.0 {
+        let inside = s109_interior() - entry.1;
+        if pc {
+            crate::diag_add!(ch_pc_nodes, inside);
+        } else {
+            crate::diag_add!(ch_null_nodes, inside);
+        }
+    }
+}
+
+#[cfg(feature = "diag")]
+static S109_NF_DEPTH: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+#[cfg(feature = "diag")]
+static S109_PF_DEPTH: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+#[cfg(feature = "diag")]
+static S109_PC_CHILD_PLY: std::sync::atomic::AtomicUsize =
+    std::sync::atomic::AtomicUsize::new(usize::MAX);
+
+/// The interior nodes a parent's move loop searches after its null move or
+/// ProbCut did not cut, closed on every way out of the node.
+#[cfg(feature = "diag")]
+struct S109Governed {
+    null: bool,
+    outer: bool,
+    start: u64,
+}
+
+#[cfg(feature = "diag")]
+impl S109Governed {
+    fn open(null: bool) -> Self {
+        let depth = if null { &S109_NF_DEPTH } else { &S109_PF_DEPTH };
+        let outer = depth.fetch_add(1, std::sync::atomic::Ordering::Relaxed) == 0;
+        if null {
+            crate::diag_count!(nf_n);
+        } else {
+            crate::diag_count!(pf_n);
+        }
+        Self {
+            null,
+            outer,
+            start: s109_interior(),
+        }
+    }
+}
+
+#[cfg(feature = "diag")]
+impl Drop for S109Governed {
+    fn drop(&mut self) {
+        let inside = s109_interior() - self.start;
+        if self.null {
+            S109_NF_DEPTH.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+            crate::diag_add!(nf_nodes, inside);
+            if self.outer {
+                crate::diag_add!(nf_nodes_outer, inside);
+            }
+        } else {
+            S109_PF_DEPTH.fetch_sub(1, std::sync::atomic::Ordering::Relaxed);
+            crate::diag_add!(pf_nodes, inside);
+            if self.outer {
+                crate::diag_add!(pf_nodes_outer, inside);
+            }
+        }
+    }
+}
