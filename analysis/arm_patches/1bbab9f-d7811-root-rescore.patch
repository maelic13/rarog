+/// The root's tiers. From `ROOT_FIXED` up, the moves placed by the table,
+/// the pool's searched moves (`apply_shared_root_scores`, from 25,000,000)
+/// and a helper's rotation, never re-scored; below them the noisy moves not
+/// yet classed, the quiets round zero, and the noisy moves that failed the
+/// good-noisy bar. Every ordering score lies within `ROOT_ORDER_SPAN` of
+/// zero, so no tier reaches the next.
+pub(in crate::search) const ROOT_FIXED: i32 = 24_000_000;
+const ROOT_NOISY: i32 = 20_000_000;
 const ROOT_BAD_NOISY: i32 = -20_000_000;
 const ROOT_ORDER_SPAN: i32 = 4_000_000;
 
+const fn is_root_fixed(score: i32) -> bool {
+    score >= ROOT_FIXED
+}
+
+const fn is_root_noisy(score: i32) -> bool {
+    !is_root_fixed(score) && score > ROOT_NOISY - ROOT_ORDER_SPAN
+}
+
+const fn is_root_quiet(score: i32) -> bool {
+    score.abs() < ROOT_ORDER_SPAN
+}
