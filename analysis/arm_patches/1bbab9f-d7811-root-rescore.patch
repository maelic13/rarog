+/// The root's picker over its whole list, in the staged picker's stages:
+/// the table move, the moves the pool or a helper's rotation placed, the
+/// noisy moves that clear the good-noisy bar, the quiets, the noisy moves
+/// that failed it. As in the donor's root, the noisy moves left are
+/// re-scored each time a good one is handed over and the quiets left before
+/// each quiet, so a pick reads the histories that the moves searched before
+/// it trained; a noisy move is classed when it is picked, on its current
+/// score. On histories that do not change between picks the order is the
+/// staged picker's, ties included.
+///
+/// The list is one array: handed entries below `index`, the remaining ones
+/// from it. The noisy moves that failed the bar are swapped down into the
+/// handed slots from `bad_start`, in the order they failed.
+pub(in crate::search) struct RootPicker {
+    moves: ScoredMoveList,
+    index: usize,
+    bad_start: usize,
+    bad_len: usize,
+    bad_index: usize,
+    noisy_left: usize,
+    good_emitted: i32,
+    tt_move: Move,
+    stage: RootStage,
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, Debug)]
+enum RootStage {
+    TtMove,
+    /// The noisy moves are scored once the table move's search is done, as
+    /// the staged picker generates them only then.
+    ScoreNoisy,
+    Ranked,
+    BadNoisy,
+}
+
+impl RootPicker {
+    /// An empty picker that hands over `tt_move` first; its list is filled
+    /// in place, as the list is too large to move by value once a window.
+    #[inline(always)]
+    pub(in crate::search) fn new(tt_move: Move) -> Self {
+        Self {
+            moves: ScoredMoveList::new(),
+            index: 0,
+            bad_start: 0,
+            bad_len: 0,
+            bad_index: 0,
+            noisy_left: 0,
+            good_emitted: 0,
+            tt_move,
+            stage: RootStage::TtMove,
+        }
+    }
+
+    /// The list to fill before the first move is taken.
+    pub(in crate::search) fn scored_mut(&mut self) -> &mut ScoredMoveList {
+        &mut self.moves
+    }
+
+    /// The next move `keep` admits, with its score's tier. A move `keep`
+    /// refuses is passed over once it is reached, as the donor's root skips
+    /// a move outside its lines, so it still counts toward the bar.
+    pub(in crate::search) fn next(
+        &mut self,
+        searcher: &Searcher,
+        board: &mut Board,
+        threats: &Threats,
+        keep: impl Fn(Move) -> bool,
+    ) -> Option<ScoredMove> {
+        loop {
+            match self.stage {
+                RootStage::TtMove => {
+                    self.stage = RootStage::ScoreNoisy;
+                    if !self.tt_move.is_null() {
+                        return Some(ScoredMove {
+                            mv: self.tt_move,
+                            score: ROOT_TT_SCORE,
+                        });
+                    }
+                }
+                RootStage::ScoreNoisy => {
+                    self.noisy_left = self.moves.as_mut_slice()[self.index..]
+                        .iter()
+                        .filter(|entry| is_root_noisy(entry.score))
+                        .count();
+                    self.rescore_noisy(searcher, board, threats);
+                    self.stage = RootStage::Ranked;
+                }
+                RootStage::Ranked => {
+                    if self.index == self.moves.len() {
+                        self.stage = RootStage::BadNoisy;
+                        continue;
+                    }
+                    if self.noisy_left == 0 {
+                        self.rescore_quiets(searcher, board, threats);
+                    }
+                    let picked = pick_next(self.moves.as_mut_slice(), self.index);
+                    if !is_root_noisy(picked.score) {
+                        self.index += 1;
+                        if picked.mv != self.tt_move && keep(picked.mv) {
+                            return Some(picked);
+                        }
+                        continue;
+                    }
+                    if self.good_emitted == 0 && self.bad_len == 0 {
+                        // Every entry below is a fixed one, handed over.
+                        self.bad_start = self.index;
+                    }
+                    self.noisy_left -= 1;
+                    let ordered = picked.score - ROOT_NOISY;
+                    let bar = good_noisy_threshold(
+                        searcher.seeds(),
+                        ordered,
+                        is_quiet_move(self.tt_move),
+                        self.good_emitted,
+                    );
+                    if board.see_ge_exchange_with_values(picked.mv, bar, KERNEL_SEE_VALUES) {
+                        self.index += 1;
+                        self.good_emitted += 1;
+                        self.rescore_noisy(searcher, board, threats);
+                        if keep(picked.mv) {
+                            return Some(picked);
+                        }
+                        continue;
+                    }
+                    let moves = self.moves.as_mut_slice();
+                    moves[self.index].score = ROOT_BAD_NOISY + ordered;
+                    moves.swap(self.index, self.bad_start + self.bad_len);
+                    self.bad_len += 1;
+                    self.index += 1;
+                }
+                RootStage::BadNoisy => {
+                    while self.bad_index < self.bad_len {
+                        let entry = self.moves.as_mut_slice()[self.bad_start + self.bad_index];
+                        self.bad_index += 1;
+                        if keep(entry.mv) {
+                            return Some(entry);
+                        }
+                    }
+                    return None;
+                }
+            }
+        }
+    }
+
+    /// The noisy moves left, scored on the histories as they are now.
+    fn rescore_noisy(&mut self, searcher: &Searcher, board: &Board, threats: &Threats) {
+        if self.noisy_left == 0 {
+            return;
+        }
+        #[cfg(feature = "diag")]
+        let before = self.best_left(is_root_noisy);
+        for entry in &mut self.moves.as_mut_slice()[self.index..] {
+            if is_root_noisy(entry.score) {
+                let score = searcher.compact_noisy_score(board, threats, entry.mv);
+                debug_assert!(score.abs() < ROOT_ORDER_SPAN, "{score}");
+                entry.score = ROOT_NOISY + score;
+            }
+        }
+        #[cfg(feature = "diag")]
+        self.count_rescore(before, is_root_noisy);
+    }
+
+    /// The quiets left, scored on the histories as they are now.
+    fn rescore_quiets(&mut self, searcher: &Searcher, board: &Board, threats: &Threats) {
+        let left = &mut self.moves.as_mut_slice()[self.index..];
+        if !left.iter().any(|entry| is_root_quiet(entry.score)) {
+            return;
+        }
+        #[cfg(feature = "diag")]
+        let before = self.best_left(is_root_quiet);
+        let ctx = searcher.quiet_context(board, threats, 0, &mut None);
+        for entry in &mut self.moves.as_mut_slice()[self.index..] {
+            if is_root_quiet(entry.score) {
+                let score = compact_quiet_score(
+                    searcher.seeds(),
+                    board,
+                    threats,
+                    &ctx,
+                    &searcher.td.hist,
+                    entry.mv,
+                );
+                debug_assert!(score.abs() < ROOT_ORDER_SPAN, "{score}");
+                entry.score = score;
+            }
+        }
+        #[cfg(feature = "diag")]
+        self.count_rescore(before, is_root_quiet);
+    }
+
+    /// The move the selection step would take next among the entries left
+    /// in a tier, and how many there are.
+    #[cfg(feature = "diag")]
+    fn best_left(&mut self, tier: fn(i32) -> bool) -> (Option<Move>, usize) {
+        let mut best: Option<ScoredMove> = None;
+        let mut count = 0;
+        for entry in &self.moves.as_mut_slice()[self.index..] {
+            if tier(entry.score) {
+                count += 1;
+                if best.is_none_or(|b| entry.score > b.score) {
+                    best = Some(*entry);
+                }
+            }
+        }
+        (best.map(|b| b.mv), count)
+    }
+
+    /// Count a re-score with two moves or more left in its tier, and
+    /// whether it changed the move taken next.
+    #[cfg(feature = "diag")]
+    fn count_rescore(&mut self, before: (Option<Move>, usize), tier: fn(i32) -> bool) {
+        if before.1 < 2 {
+            return;
+        }
+        crate::diag_count!(root_rescores);
+        if self.best_left(tier).0 != before.0 {
+            crate::diag_count!(root_rescore_changes);
+        }
+    }
+}
