+
+#[cfg(test)]
+mod scratch_krpkr {
+    use super::*;
+    use crate::syzygy::{self, Wdl};
+    use std::sync::atomic::Ordering;
+
+    #[test]
+    #[ignore]
+    fn sample() {
+        let path = std::env::var("RAROG_SYZYGY_PATH").expect("path");
+        assert!(syzygy::initialize(&path) >= 5);
+        let mut state: u64 = 0x9E37_79B9_7F4A_7C15;
+        let mut next = move || {
+            state ^= state >> 12;
+            state ^= state << 25;
+            state ^= state >> 27;
+            state.wrapping_mul(0x2545_F491_4F6C_DD1D)
+        };
+        let samples: usize = std::env::var("KRPKR_SAMPLES").ok().and_then(|s| s.parse().ok()).unwrap_or(2_000_000);
+        let mut legal = 0usize;
+        let mut decisive_for_strong = 0usize;
+        let mut per_site = [[0usize; 4]; 6]; // [site][draw, strong wins, weak wins, cursed/blessed]
+        let mut examples: Vec<String> = Vec::new();
+        while legal < samples {
+            let strong_white = next() & 1 == 0;
+            let white_to_move = next() & 2 == 0;
+            let sq: Vec<usize> = (0..5).map(|_| (next() >> 20) as usize % 64).collect();
+            let (sk, wk2, sr, wr2, pawn) = (sq[0], sq[1], sq[2], sq[3], sq[4]);
+            let mut seen = [false; 64];
+            if sq.iter().any(|&s| std::mem::replace(&mut seen[s], true)) { continue; }
+            if pawn < 8 || pawn >= 56 { continue; }
+            let mut board_sq = ['.'; 64];
+            let (k, kk, r, rr, pp) = if strong_white { ('K', 'k', 'R', 'r', 'P') } else { ('k', 'K', 'r', 'R', 'p') };
+            board_sq[sk] = k; board_sq[wk2] = kk; board_sq[sr] = r; board_sq[wr2] = rr; board_sq[pawn] = pp;
+            let mut s = String::new();
+            for rank in (0..8).rev() { let mut e = 0; for f in 0..8 { let c = board_sq[rank*8+f]; if c == '.' { e += 1; continue; } if e > 0 { s.push_str(&e.to_string()); e = 0; } s.push(c); } if e > 0 { s.push_str(&e.to_string()); } if rank > 0 { s.push('/'); } }
+            let fen = format!("{s} {} - - 0 1", if white_to_move { 'w' } else { 'b' });
+            let Ok(board) = Board::from_fen(&fen) else { continue };
+            if board.is_in_check() || board.generate_legal_moves().iter().any(|m| m.is_capture() || m.promotion().is_some()) { continue; }
+            legal += 1;
+            KRPKR_SITE.store(0, Ordering::Relaxed);
+            let scale = krpkr_scale(&board);
+            let site = KRPKR_SITE.load(Ordering::Relaxed);
+            let wdl = syzygy::probe_wdl(&board, false).expect("KRPvKR answers");
+            let strong_to_move = (board.side_to_move() == Color::White) == strong_white;
+            let class = match (wdl, strong_to_move) {
+                (Wdl::Draw, _) => 0,
+                (Wdl::Win, true) | (Wdl::Loss, false) => 1,
+                (Wdl::Win, false) | (Wdl::Loss, true) => 2,
+                _ => 3,
+            };
+            if class == 1 { decisive_for_strong += 1; }
+            if scale == Some(0) {
+                assert!(site >= 1, "a zero with no site tag: {fen}");
+                per_site[site][class] += 1;
+                if class != 0 && examples.len() < 40 { examples.push(format!("site {site} {fen} {wdl:?}")); }
+            } else {
+                assert_eq!(site, 0);
+            }
+        }
+        eprintln!("{legal} quiet legal random KRPKR positions; strong side wins {decisive_for_strong}");
+        for site in 1..=5 {
+            let [d, w, l, c] = per_site[site];
+            eprintln!("site {site}: zeros {} : WDL draw {d}, strong side wins {w}, weak side wins {l}, cursed/blessed {c}", d + w + l + c);
+        }
+        for e in &examples { eprintln!("  {e}"); }
+    }
+}
